{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: ucenik (debug, no reload)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--port", "8080"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Python: Current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v", "${file}"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Python: All tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Celery worker (debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": ["-A", "ucenik.workers.celery_app", "worker", "--pool=solo", "--loglevel=info"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
