# development enables Swagger/ReDoc at /docs and /redoc; anything else
# (notably production, the default if unset) disables them - see core/config.py
ENVIRONMENT=development

# docker-compose.yaml's mongo container sets MONGO_INITDB_ROOT_USERNAME/
# PASSWORD, which turns auth ON server-wide - credentials are required
# even locally, not just in prod.
MONGODB_URL=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGODB_DB_NAME=ucenik

REDIS_URL=redis://localhost:6379

# CORS - origin(s) the frontend is served from, comma-separated if more than
# one (e.g. a local dev server + a deployed preview URL). See core/config.py.
FRONTEND_URL=http://localhost:3000

JWT_SECRET=changeme-generate-a-real-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_QUOTA=600000  # tokens/user/day - see core/quota.py

# The self-hosted LLM proxy (src/ucenik/llm_proxy/, run separately - see
# that package's docstring for the run command) - not a placeholder anymore.
# LLM_PROXY_MODEL is advisory only: the proxy always overrides it with its
# own GROQ_MODEL below, never trusts what a caller sends.
LLM_PROXY_URL=http://localhost:4000
LLM_PROXY_API_KEY=
LLM_PROXY_MODEL=gpt-4o-mini
LLM_PROXY_TIMEOUT_SECONDS=30

# The LLM proxy's own settings (src/ucenik/llm_proxy/config.py) - it reads
# this same .env file. GROQ_API_KEY is the one secret you must actually
# supply yourself (console.groq.com) - nothing above this line can be
# filled in for you. LLM_PROXY_API_KEY above doubles as this service's
# required shared secret (both sides read the same var) - leave both empty
# for local dev (auth disabled), set a real value on both before this is
# reachable from anywhere but localhost. Groq is the fallback upstream,
# tried only if Hugging Face's request fails (network error or a non-2xx
# status) - see llm_proxy/main.py's _upstreams(). Always present regardless
# of HF_API_KEY below - groq_api_key is the one credential this service
# assumes is always configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Primary upstream, tried first - see llm_proxy/main.py's _upstreams().
# Optional: leave HF_API_KEY empty to skip it entirely (Groq-only,
# behavior identical to before this existed). Uses Hugging Face's
# OpenAI-compatible Inference Providers router -
# https://huggingface.co/docs/inference-providers - get a token at
# https://huggingface.co/settings/tokens.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# MinIO (S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Embedding / chunking - see rag/embedder.py, rag/chunker.py, docs/rag-notes.md.
# EMBEDDING_MODEL here is only for rag/chunker.py's tokenizer (sizing chunks
# in tokens) - the full model with weights is loaded by the embedding
# service below, not by this app or the Celery worker directly.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_TOKENS=8192
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# The self-hosted embedding service (src/ucenik/embedding_service/, run
# separately - see that package's docstring for the run command, or
# `make embedding-service`) - loads BGE-M3 exactly once so `app` and the
# Celery `worker` don't each load their own independent copy. Same shared-
# secret pattern as LLM_PROXY_API_KEY above: empty disables auth, fine for
# local dev.
EMBEDDING_SERVICE_URL=http://localhost:4001
EMBEDDING_SERVICE_API_KEY=
EMBEDDING_SERVICE_TIMEOUT_SECONDS=60
