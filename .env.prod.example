# Template for the .env that lives ON THE DEPLOY SERVER, used by
# docker-compose.prod.yaml. NOT the same file as your local .env - the app
# runs as a container on the same docker network as the infra services here,
# so it must reach them by service name (mongodb, redis, ...), not localhost.
#
# On the server: copy this to .env, fill in real secrets, keep it out of git
# (already covered by .gitignore).

# production disables Swagger/ReDoc (/docs, /redoc, /openapi.json) - this
# is also the default if ENVIRONMENT is left unset, but set it explicitly
# here so it's obvious this server is meant to run locked down.
ENVIRONMENT=production

# The domain Caddy requests a TLS cert for and routes to `app` - see
# ./Caddyfile, docker-compose.prod.yaml's `caddy` service. Must already
# resolve (DNS A/AAAA record) to this server before `caddy` starts, or the
# Let's Encrypt HTTP challenge fails and it retries with backoff instead of
# serving anything.
DOMAIN=changeme.example.com

MONGODB_URL=mongodb://admin:admin@mongodb:27017/?authSource=admin
MONGODB_DB_NAME=ucenik

REDIS_URL=redis://redis:6379

# CORS - the real deployed frontend origin(s), comma-separated if more than
# one. Unlike the infra URLs above, this is NOT a docker-network address -
# it's whatever origin the browser actually loads the frontend from.
FRONTEND_URL=https://changeme.example.com

JWT_SECRET=changeme-generate-a-real-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_QUOTA=1000

# Docker-network service name, not localhost - same reasoning as the
# header comment above. (Previously localhost here - a real bug: harmless
# only because the proxy itself didn't exist yet to expose it.)
LLM_PROXY_URL=http://llm-proxy:4000
# Shared secret required on both ends (this app's outgoing calls AND the
# llm-proxy service's incoming check, see GROQ section below) - generate a
# real random value, same as JWT_SECRET.
LLM_PROXY_API_KEY=changeme-generate-a-real-random-secret
LLM_PROXY_MODEL=gpt-4o-mini
LLM_PROXY_TIMEOUT_SECONDS=30

# The llm-proxy service's own settings (src/ucenik/llm_proxy/config.py,
# docker-compose.prod.yaml's `llm-proxy` service - same .env, same
# container image as `app`/`worker`, different command). GROQ_API_KEY is
# the one secret here you must supply yourself (console.groq.com).
GROQ_API_KEY=changeme-real-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1

CHROMA_HOST=chromadb
CHROMA_PORT=8000

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_TOKENS=8192
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# Image reference for docker-compose.prod.yaml - GitHub Actions pushes here
# (.github/workflows/deploy.yml), computed automatically as
# ghcr.io/<owner>/<repo>:latest - fill in your actual GitHub owner/repo.
GHCR_IMAGE=ghcr.io/OWNER/ucenik:latest

# Grafana admin login (see docker-compose.yaml) - change from the default.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Local backups (backup/*.sh, docker-compose.prod.yaml's backup-mongo /
# backup-minio services) - both read these, defaults shown are the scripts'
# own fallback if left unset.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
