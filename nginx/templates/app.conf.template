# HTTPS server for ${DOMAIN} - reverse-proxies to `app` over the
# docker-internal network. Replaces ./Caddyfile (docs/security-hardening.md
# item 1) - see docker-compose.prod.yaml's `nginx-certbot` service for how
# this gets here: mounted read-only into /etc/nginx/templates/, and the
# image's own docker-entrypoint.d/20-envsubst-on-templates.sh runs envsubst
# on every *.template file in that directory before nginx starts, writing
# the result (this file, with ${DOMAIN} filled in) to /etc/nginx/conf.d/.
#
# Port 80 (HTTP->HTTPS redirect + the Let's Encrypt HTTP-01 ACME challenge
# path) is NOT defined here - the jonasal/nginx-certbot image ships its own
# generic `redirector.conf` in /etc/nginx/conf.d/ that already does exactly
# that for any domain, unconditionally. Nothing to add or override for it.
#
# The image discovers which domain(s) to request a certificate for by
# grepping every *.conf file under conf.d/ for `server_name` and
# `ssl_certificate_key` lines (see /scripts/util.sh's parse_server_names/
# parse_cert_names) - so as long as this file ends up there with a real
# (envsubst'd) domain in both places, certbot picks it up with no separate
# configuration step.

# Standard nginx WebSocket-upgrade map (docs/nginx.org's own recommended
# pattern) - api/ws.py's /ws/plans/{plan_id} needs `Connection: upgrade`
# only on requests that are actually asking to upgrade; everything else
# should get ordinary keep-alive. Caddy's reverse_proxy did this
# automatically; nginx needs it spelled out.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    # Auto-created on first boot if missing (scripts/create_dhparams.sh,
    # baked into the image) - takes a couple minutes the very first time,
    # persisted afterwards in the letsencrypt_certs volume alongside the
    # certs themselves, so this cost is paid once per deploy target, not
    # once per restart.
    ssl_dhparam /etc/letsencrypt/dhparams/dhparam.pem;

    # Real upload limit needs to be >= services/documents.py's MAX_FILE_SIZE
    # (50MB), or nginx's own default of 1MB rejects every upload with a 413
    # before the app - and its own Content-Length pre-check (docs/security-
    # hardening.md item 3) - ever sees the request. A little headroom above
    # 50MB, not exactly 50MB, for multipart overhead (boundaries, field
    # headers) that isn't file bytes.
    client_max_body_size 55m;

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        # Real client IP forwarded to the app, instead of every request
        # showing up as nginx's own container IP. core/rate_limit.py trusts
        # these specifically from this proxy (see docs/security-hardening.md
        # item 6/throttle for the app-side half of this fix - uvicorn's
        # --proxy-headers/--forwarded-allow-ips).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Longer than nginx's 60s default - a slow LLM stream (Tutor chat's
        # SSE) or an idle-but-open plan-progress WebSocket shouldn't get cut
        # off mid-response just because nginx got impatient waiting on app.
        proxy_read_timeout 300s;
    }
}
