# Template for secrets.env (gitignored). `make k8s-secrets` creates it with
# random values and copies GROQ_API_KEY / HF_API_KEY from the repo-root .env.
# Every key below must exist (it may be empty) - pods reference them by name
# and will not start if one is missing.
#
# Keep MONGO_PASSWORD URL-safe (letters/digits): it is substituted into
# MONGODB_URL as-is.
JWT_SECRET=change-me
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
LLM_PROXY_API_KEY=change-me
EMBEDDING_SERVICE_API_KEY=change-me
GROQ_API_KEY=
HF_API_KEY=
