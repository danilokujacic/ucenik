# Reverse proxy + automatic HTTPS (Let's Encrypt, zero manual cert
# management) for the deployed app - see docker-compose.prod.yaml's `caddy`
# service. {$DOMAIN} is substituted from the DOMAIN env var (.env.prod.example)
# - Caddy needs it to know what hostname to request a cert for and where to
# route; there's no way to make this domain-agnostic and still get TLS.
#
# Only `app` is fronted here on purpose - mongodb/redis/chromadb/minio/
# grafana/loki are internal-only (see docker-compose.prod.yaml's hardening
# comment), nothing else needs a public route.
{$DOMAIN} {
	reverse_proxy app:8000

	# stdout -> promtail -> Loki, same pipeline every other container's
	# logs already flow through (see docs/observability.md).
	log {
		output stdout
		format json
	}
}
