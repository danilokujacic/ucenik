# The backend API's base URL (src/ucenik/, `uv run fastapi dev` in dev -
# see docs/frontend-spec.md §1). Also tell whoever owns the backend .env
# what origin this frontend runs on (FRONTEND_URL there) - CORS is strict
# and a mismatch fails silently from here, only visible in the browser
# console.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Planner progress WebSocket base (`/ws/plans/{plan_id}`). Defaults to
# NEXT_PUBLIC_API_URL with http(s) swapped for ws(s) if unset - only set
# this explicitly if the WS endpoint is fronted differently than the REST
# API (e.g. a reverse proxy that splits them).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
